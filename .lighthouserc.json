{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$)",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
